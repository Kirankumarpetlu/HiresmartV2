# Hugging Face (optional for public models)
HF_TOKEN=your_huggingface_token_here
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=resume_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resume_user:change_me@localhost:5432/resume_db
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768
EMBED_DEVICE=cpu
LLM_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
LLM_FILE=*q4_k_m.gguf
LLM_N_CTX=4096
LLM_N_GPU_LAYERS=-1
LLM_MAX_TOKENS=600
SHORTLIST_SIZE=10
LLM_CONCURRENCY=1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
DATA_DIR=./data
CHUNK_TARGET=256
CHUNK_MAX=400
CHUNK_OVERLAP_PCT=0.125
USE_QUERY_PREFIX=false
AGG_MODE=top3_mean
EVALUATOR_SPLIT_CALLS=false
CACHE_ENABLED=true
CACHE_TTL_DAYS=7
GITHUB_ENABLED=true
# Fine-grained PAT with read-only access to public repositories, or classic PAT without scopes.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_CACHE_TTL_HOURS=24
GITHUB_MAX_REPOS=8
GITHUB_CATALOG_MAX_PAGES=3
GITHUB_COMMITS_PER_PAGE=10
# Upper cap on the reserve. Effective reserve is the smaller of this cap and 10% of the bucket, rounded up.
# blocked_config means the work cannot fit in a fresh quota window. Set GITHUB_TOKEN for a no_token block.
GITHUB_RESERVE_REMAINING=200
GITHUB_MAX_CONCURRENCY=4
GITHUB_SHORTLIST_SIZE=100
GITHUB_STABLE_CACHE_TTL_HOURS=120
GITHUB_PARTIAL_WEIGHT_FACTOR=0.5
GITHUB_TIMEOUT_SECONDS=10
GITHUB_SCORE_WEIGHTS=[0.4,0.2,0.2,0.2]
INTERVIEW_THRESHOLD=75
GITHUB_MIN_SCORE=40
# EMAIL_MAX_SELECTED=3
SEND_REJECTION_EMAILS=false
EMAIL_AUTO_SEND=false
EMAIL_DRY_RUN=true
COMPANY_NAME=Our hiring team
RECRUITER_NAME=Recruiting Team
RECRUITER_EMAIL=
NEXT_STEP_TEXT=Please reply with your availability.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
EMAIL_FROM=recruiting@example.org
EMAIL_RATE_PER_MINUTE=20
EMAIL_MAX_RETRIES=3
